# Copy to api/.dev.vars (gitignored) for local `wrangler dev`.
ENVIRONMENT=development
# The web app's address: Vite's dev server, which proxies /api to this Worker.
APP_ORIGIN=http://localhost:5173
# Leave empty locally to print sign-in codes in the wrangler console instead of emailing them.
RESEND_API_KEY=
# From Google Cloud Console → APIs & Services → Credentials (OAuth client, type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sentry DSN for the Worker. Leave empty locally so development errors aren't reported.
SENTRY_DSN=
# Turnstile bot check on email sign-in. Locally, Cloudflare's test keys: the widget always passes.
# Leave both empty to switch the check off.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
