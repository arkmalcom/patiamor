{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Top level = PRODUCTION. Staging is always `--env staging`.
  "name": "patiamor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // TURNSTILE_SITE_KEY: the public key of the "patiamor.com" Turnstile widget (its secret is TURNSTILE_SECRET, set before the key goes live).
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://patiamor.com",
    "EMAIL_FROM": "Patiamor <hola@patiamor.com>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFbsDPF5D7UP5b68"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mascota/*", "/robots.txt", "/sitemap.xml"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "patiamor-db", "database_id": "0b6d481c-1d8d-45cd-aa54-6cf14a856c28", "migrations_dir": "migrations" }
  ],
  // Pet photos (PAT-9).
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "patiamor-photos" }],
  // Custom domains: Cloudflare creates their DNS records. Staging stays on workers.dev.
  "routes": [
    { "pattern": "patiamor.com", "custom_domain": true },
    { "pattern": "www.patiamor.com", "custom_domain": true }
  ],
  // The morning job (digest.ts): shelters' new requests and "Avísame" alerts. 12:00 UTC = 8:00 in the DR.
  "triggers": { "crons": ["0 12 * * *"] },
  // Writes per account (or per IP when signed out), per minute: the first guard against floods that would
  // spend the free plan's daily D1 writes (index.ts). Counted per Cloudflare location, roughly.
  "ratelimits": [{ "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "env": {
    "staging": {
      // Bindings and routes are NOT inherited by environments; repeat them here.
      "d1_databases": [
        { "binding": "DB", "database_name": "patiamor-db-staging", "database_id": "60ec559a-2dbd-4b9e-87bf-de58a0793cb4", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "patiamor-photos-staging" }],
      // APP_ORIGIN: where links in emails sent outside a request (the morning job) point.
      // TURNSTILE_SITE_KEY: the public key of the "patiamor-staging" Turnstile widget (its secret is TURNSTILE_SECRET).
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ORIGIN": "https://patiamor-staging.patiamor-api.workers.dev",
        "EMAIL_FROM": "Patiamor <hola@patiamor.com>",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFWI2gObPDXi9PRR"
      },
      // Bindings and triggers are repeated per environment. 12:00 UTC = 8:00 in the Dominican Republic.
      "triggers": { "crons": ["0 12 * * *"] },
      "ratelimits": [{ "name": "WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }],
      "routes": [],
      "workers_dev": true
    }
  }
}
