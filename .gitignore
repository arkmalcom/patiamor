# Dependencies & builds
node_modules/
dist/
*.tsbuildinfo
coverage/

# Cloudflare / secrets
.wrangler/
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
backups/

# Impeccable: keep design.json, surfaces/ and decision/ (durable design context); ignore scratch
.impeccable/review/
.impeccable/questions/
